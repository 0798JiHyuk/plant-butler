{
  "name": "plant-keeper-demo",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src supabase/functions vite.config.ts --deny typescript/no-explicit-any --deny-warnings",
    "test": "vitest run",
    "db:test": "node tools/db-local.mjs test",
    "db:types": "node tools/db-local.mjs types",
    "db:types:check": "node tools/db-local.mjs types-check",
    "db:check": "node tools/check-migrations.mjs",
    "db:tools:test": "node --test tools/tests/migrations.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
