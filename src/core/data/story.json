{
  "intro": {
    "start": "p01-1",
    "always": [
      "free-packet"
    ],
    "nodes": {
      "p01-1": {
        "who": "nuri",
        "text": "어? 새 손님이다.",
        "next": "p01-2"
      },
      "p01-2": {
        "who": "nuri",
        "text": "안녕. 난 느리야. 여기서 제일 느리게 걷는 달팽이지.",
        "next": "p01-3"
